# =====================================================
# FastWeb API - variaveis de ambiente
# Valores de EXEMPLO. Substitua pelos reais depois.
# Copie este arquivo para ".env" antes de rodar.
# =====================================================

NODE_ENV=development
PORT=4000

# --- Banco de dados (MongoDB local ou Atlas) ---
# Aceita 3 formatos:
#   1) URI completa com usuario e senha embutidos;
#   2) URI sem credenciais + MONGODB_USERNAME / MONGODB_PASSWORD;
#   3) URI colada do Atlas com os placeholders <db_username>:<db_password>
#      (nesse caso as duas variaveis abaixo sao obrigatorias).
# Nome do banco e opcoes (retryWrites/w=majority) sao adicionados automaticamente.
MONGODB_URI=mongodb+srv://cluster0.exemplo.mongodb.net
MONGODB_USERNAME=usuario_exemplo
MONGODB_PASSWORD=senha_exemplo
MONGODB_DB=vapt

# --- Autenticacao (JWT em cookie httpOnly) ---
# Em producao e OBRIGATORIO. Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria_de_48_bytes
JWT_EXPIRES_IN=7d
AUTH_COOKIE_NAME=fw_token
AUTH_COOKIE_MAX_AGE_MS=604800000
BCRYPT_ROUNDS=10

# --- Imagens do painel (WEBP em base64 no MongoDB) ---
IMAGE_WEBP_QUALITY=82
IMAGE_AVATAR_MAX_SIZE=512
IMAGE_MAX_SIZE=1280
MAX_IMAGE_BYTES=2097152

# --- WhatsApp que recebe o fechamento do plano (checkout manual) ---
ADMIN_WHATSAPP=5511999999999

# --- CORS: origens liberadas, separadas por virgula ---
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# --- Dados publicos da empresa (exibidos na landing) ---
COMPANY_NAME=FastWeb Tecnologia LTDA
COMPANY_CNPJ=12.345.678/0001-90
COMPANY_CITY=Sao Paulo - SP
SUPPORT_WHATSAPP=5511999999999
SUPPORT_EMAIL=contato@vapt.com.br
SUPPORT_HOURS=Seg a Sab, 8h as 22h

# --- Armazenamento de imagens (logo e fotos do cardapio) ---
# Sem credencial preenchida, a API grava os arquivos em disco (UPLOAD_DIR) e serve
# por /uploads. Em nenhum caso o base64 vai para o MongoDB.
# Crie uma conta gratuita em cloudinary.com e copie os 3 valores do Dashboard.
CLOUDINARY_CLOUD_NAME=nome_exemplo
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=segredo_exemplo
CLOUDINARY_FOLDER=vapt
# Alternativa: uma unica variavel no lugar das tres acima.
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Pasta do driver local (relativa a apps/api) e limite por imagem
UPLOAD_DIR=uploads
MAX_IMAGE_BYTES=2097152

# URL publica desta API: usada para montar o link das imagens no driver local
PUBLIC_BASE_URL=http://localhost:4000

# --- Login com Google (OAuth 2.0) ---
# Crie as credenciais em: console.cloud.google.com
#   APIs e servicos > Credenciais > Criar credenciais > ID do cliente OAuth
#   Tipo: "Aplicativo da Web"
#
# Em "URIs de redirecionamento autorizados" cole EXATAMENTE o valor de
# GOOGLE_REDIRECT_URI abaixo — precisa bater caractere a caractere, incluindo
# a porta e a ausencia de barra no fim, senao o Google recusa com redirect_uri_mismatch.
#
# Deixe as duas primeiras vazias (ou com os valores de exemplo) para manter o
# login do Google desligado: a API sobe normalmente e so o login por senha funciona.
GOOGLE_CLIENT_ID=000000000000-exemplo.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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s
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Para onde o usuario volta depois do consentimento do Google.
# Em producao aponte para o dominio do painel (ex.: https://app.seudominio.com).
WEB_APP_URL=http://localhost:5173

# --- Integracoes futuras (placeholders) ---
WHATSAPP_API_URL=https://api.exemplo.com/whatsapp/v1
WHATSAPP_API_TOKEN=token_de_exemplo_trocar_depois
MERCADOPAGO_ACCESS_TOKEN=TEST-0000000000000000-000000-exemplo
STRIPE_SECRET_KEY=sk_test_exemplo

# --- Limites ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
