{
  "name": "@vapt/web",
  "version": "1.0.9",
  "private": true,
  "type": "module",
  "description": "Aplicativo da equipe do Vapt — PDV, cozinha e recepção.",
  "author": "Vapt",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:app": "vite build --config vite.app.config.ts --mode app",
    "build:win": "npm run build:app && electron-builder --win --publish never",
    "build:android": "npm run build:app && npx cap sync android && cd android && .\\gradlew.bat assembleDebug",
    "build:android:release": "npm run build:app && npx cap sync android && cd android && .\\gradlew.bat assembleRelease",
    "app:desktop": "npm run build:app && electron .",
    "deploy:apps": "node scripts/deploy-apps.mjs",
    "build:apps": "node scripts/build-apps.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.2",
    "@capacitor/geolocation": "^6.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.37.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.3",
    "resend": "^6.26.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.2",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.vapt.equipe",
    "productName": "Vapt Equipe",
    "artifactName": "Vapt-Setup.${ext}",
    "files": [
      "electron/**/*",
      "dist-app/**/*",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "../../releases"
    },
    "electronVersion": "33.4.11",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vapt Equipe"
    }
  }
}
