# =====================================================
# Vapt Web (Vite) - variaveis de ambiente
# Valores de EXEMPLO. Copie para ".env" e ajuste depois.
# Tudo aqui vai para o bundle publico: nada de segredo.
# =====================================================

# Base da API. Em dev pode deixar "/api" (o Vite faz proxy para :4000).
VITE_API_URL=/api
VITE_APP_VERSION=1.0.0
VITE_DOWNLOAD_BASE_URL=https://vapt-web.vercel.app

# Dados de contato exibidos na landing
VITE_WHATSAPP=5511999999999
VITE_SUPPORT_EMAIL=contato@exemplo.com.br
VITE_COMPANY_NAME=Sua Empresa LTDA
VITE_COMPANY_CNPJ=00.000.000/0001-00

# Links das lojas do app parceiro (placeholders)
VITE_ANDROID_APP_URL=https://play.google.com/store/apps/details?id=com.vapt.parceiro
VITE_IOS_APP_URL=https://apps.apple.com/br/app/vapt-parceiro/id0000000000

# Analytics (opcional)
VITE_GA_ID=G-EXEMPLO000

# =====================================================
# Instaladores nativos (.exe e .apk)
# =====================================================
# Os binarios NAO ficam no repositorio: o .exe tem ~78 MB e, uma vez
# commitado, ficaria no historico do Git para sempre. Eles sao publicados
# como assets de um GitHub Release, e estas variaveis apontam para la.
#
# COMO PREENCHER
# --------------
# Troque SEU_USUARIO e SEU_REPOSITORIO pelos seus. Mantenha o trecho
# "/releases/latest/download/": ele resolve sempre para o release mais
# recente, entao voce configura estas duas linhas UMA vez e nunca mais
# mexe nelas — publicar a v1.1.0 e so criar um release novo.
#
# O nome do arquivo no final da URL precisa ser IGUAL ao nome do asset
# enviado no release. Os scripts de build ja geram exatamente estes dois
# nomes dentro de builds/ (veja builds/README.md):
#
#     builds/vapt-setup.exe
#     builds/vapt.apk
#
# ATENCAO: o repositorio dos releases precisa ser PUBLICO. Em repositorio
# privado, a URL de um asset exige token de autenticacao, e a pagina
# /download e publica — o download falharia para todos. O codigo-fonte pode
# continuar privado: basta criar um segundo repositorio, publico, so com os
# releases. Nenhuma linha de codigo precisa ir para ele.
#
# Vazias, os botoes da /download aparecem como "Em breve" em vez de levarem
# a um 404 — que e pior, porque o lojista conclui que o app nao existe.
#
# LEMBRETE DE DEPLOY: variavel VITE_ e lida na COMPILACAO, nao em execucao.
# Salvar na Vercel nao muda nada sozinho; e preciso um Redeploy depois.
VITE_EXE_URL=https://github.com/SEU_USUARIO/SEU_REPOSITORIO/releases/latest/download/vapt-setup.exe
VITE_APK_URL=https://github.com/SEU_USUARIO/SEU_REPOSITORIO/releases/latest/download/vapt.apk
