# Variaveis do build do APLICATIVO NATIVO (APK e .exe).
# Copie para `.env.app` e troque pelos seus valores.
#
# Este arquivo NAO e usado pelo site: o site continua lendo `.env`.

# Endereco da API. Precisa ser ABSOLUTO e terminar em /api.
# O aplicativo abre em file:// e nao consegue resolver um caminho relativo,
# entao o build recusa qualquer valor que nao comece com http:// ou https://.
VITE_API_URL=https://sua-api.exemplo.com/api

# Versao gravada dentro do APK/EXE e origem publica dos instaladores.
VITE_APP_VERSION=1.0.0
VITE_APP_BUILD_ID=1.0.0
VITE_DOWNLOAD_BASE_URL=https://vapt-web.vercel.app

# Assinatura fixa da versão Android de produção. A mesma chave deve ser usada
# em toda publicação para que o APK novo substitua o instalado.
VAPT_ANDROID_KEYSTORE_FILE=C:/segredos/vapt-release.jks
VAPT_ANDROID_KEYSTORE_PASSWORD=troque-aqui
VAPT_ANDROID_KEY_ALIAS=vapt
VAPT_ANDROID_KEY_PASSWORD=troque-aqui
VAPT_ANDROID_VERSION_CODE=1000000
